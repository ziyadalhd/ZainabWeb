NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical public origin. Replace this value when a custom domain is approved.
SITE_URL=https://bayn-cultural-club.vercel.app
# Optional: Set to true to disable search engine indexing on non-production environments.
SITE_INDEXING_DISABLED=false
# Optional: admin-only alerts via the Telegram Bot API. Leave unset to disable.
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
