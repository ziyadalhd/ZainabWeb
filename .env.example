NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical public origin. Replace this value when a custom domain is approved.
SITE_URL=https://bayn-cultural-club.vercel.app
# Keep false until the explicit public-launch decision and legal-content approval.
SITE_INDEXING_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Use true for a development/staging environment that should enforce Turnstile.
# Vercel Production is always enforced, even when this value is omitted.
TURNSTILE_ENFORCE=false
