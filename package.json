{
  "name": "bayn-cultural-club",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components features lib proxy.ts next.config.ts vitest.config.mts vitest.setup.ts",
    "format": "prettier --write app components features lib proxy.ts next.config.ts vitest.config.mts vitest.setup.ts",
    "format:check": "prettier --check app components features lib proxy.ts next.config.ts vitest.config.mts vitest.setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@daypicker/react": "10.0.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
